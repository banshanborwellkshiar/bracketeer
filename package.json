{
  "name": "achilles-esports-tournament-bot",
  "version": "2.0.0",
  "description": "A professional Discord tournament bot for ACHILLES ESPORTS with slot list management, bracket generation, and live tournament tracking",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node src/index.js",
    "lint": "eslint .",
    "register:guild": "node src/deploy-commands.js",
    "register:global": "node src/deploy-commands.js --global",
    "deploy": "npm run register:guild && npm start"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/achilles-esports/tournament-bot.git"
  },
  "keywords": [
    "discord",
    "tournament",
    "bot",
    "esports",
    "bracket",
    "slot-list",
    "quotient"
  ],
  "author": "ACHILLES ESPORTS",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "firebase-admin": "^12.5.0",
    "moment": "^2.29.4",
    "sharp": "^0.34.5",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "eslint": "^9.14.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
